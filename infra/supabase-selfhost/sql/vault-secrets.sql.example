-- Run ONCE on the self-hosted DB after restoring the cloud dump (vault.secrets
-- is extension data and is not part of the dump). Copy to vault-secrets.sql,
-- fill in, run, then delete the copy:
--   docker exec -i supabase-db psql -U postgres -d postgres < sql/vault-secrets.sql
--
-- app_supabase_url is the *internal* gateway URL: pg_net runs inside the
-- compose network and calls /functions/v1/send-push through Envoy.
SELECT vault.create_secret('http://kong:8000',        'app_supabase_url',     'Internal API gateway URL for pg_net → send-push');
SELECT vault.create_secret('<SERVICE_ROLE_KEY>',      'app_service_role_key', 'service_role JWT for pg_net → send-push');
SELECT vault.create_secret('<VAPID_PUBLIC_KEY>',      'vapid_public_key',     'Web Push VAPID public key');
SELECT vault.create_secret('<VAPID_PRIVATE_KEY>',     'vapid_private_key',    'Web Push VAPID private key');
SELECT vault.create_secret('mailto:support@bystrobarista.com', 'vapid_subject', 'Web Push VAPID contact');
SELECT vault.create_secret('true',                    'send_web_push',        'Web Push rollout flag');

SELECT name, created_at FROM vault.secrets ORDER BY name;
