############
# Self-hosted Supabase for BystroBarista — copy to .env on the server and fill in.
# Never commit .env. Generate secrets with:
#   sh utils/generate-keys.sh            (then REPLACE JWT_SECRET/ANON_KEY/SERVICE_ROLE_KEY
#                                         with the CLOUD project's values, see README)
#   sh utils/add-new-auth-keys.sh --update-env   (ES256 key pair + JWT_JWKS)
############

COMPOSE_FILE=docker-compose.yml

############
# Secrets
############

POSTGRES_PASSWORD=

# Copy from Supabase Dashboard → Project Settings → API → JWT Settings of the
# cloud project. Reusing it keeps the anon/service keys in shipped iOS builds
# and every existing session valid across the cutover.
JWT_SECRET=
# Legacy HS256 API keys — the cloud project's anon / service_role keys verbatim.
ANON_KEY=
SERVICE_ROLE_KEY=

# Asymmetric (ES256) signing keys. Generated by utils/add-new-auth-keys.sh.
# apps/web/src/middleware.ts verifies sessions locally via
# /auth/v1/.well-known/jwks.json, so these are required, not optional.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# Studio basic auth (reachable only through an SSH tunnel to 127.0.0.1:8000).
DASHBOARD_USERNAME=bystrobarista
DASHBOARD_PASSWORD=

SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

############
# URLs
############

SUPABASE_PUBLIC_URL=https://api.bystrobarista.com
API_EXTERNAL_URL=https://api.bystrobarista.com/auth/v1

############
# Database
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
PGRST_DB_POOL=20

POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=bystrobarista
POOLER_DB_POOL_SIZE=5

############
# Studio
############

STUDIO_DEFAULT_ORGANIZATION=BystroBarista
STUDIO_DEFAULT_PROJECT=bystrobarista-prod
OPENAI_API_KEY=

############
# Auth (Dashboard → Authentication → URL Configuration / Providers of the cloud project)
############

SITE_URL=https://app.bystrobarista.com
# Comma-separated. Copy the full Redirect URLs list from the cloud Dashboard;
# these are the known ones (web callback, admin callback, iOS deep link).
ADDITIONAL_REDIRECT_URLS=https://app.bystrobarista.com/**,https://bystrobarista.com/backbar/**,http://localhost:3000/**,bystrobarista://**

JWT_EXPIRY=3600
DISABLE_SIGNUP=false

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
RATE_LIMIT_EMAIL_SENT=60

# SMTP — Resend (docs/resend-custom-domain.md). Same values as Dashboard → Auth → SMTP.
SMTP_ADMIN_EMAIL=noreply@bystrobarista.com
SMTP_HOST=smtp.resend.com
# Timeweb blocks outbound 25/465/587; Resend also listens on 2465 (TLS) and 2587 (STARTTLS).
SMTP_PORT=2465
SMTP_USER=resend
SMTP_PASS=
SMTP_SENDER_NAME=БыстроБариста

# Sign in with Apple. CLIENT_IDS = iOS bundle id + web Services ID (comma-separated).
# CLIENT_SECRET = ES256 JWT from the SIWA .p8 (scripts/apple-client-secret.mjs),
# valid ≤ 6 months — regenerate before it expires.
APPLE_ENABLED=true
APPLE_CLIENT_IDS=com.quickbarista.app,com.bystrobarista.web
APPLE_CLIENT_SECRET=
APPLE_WEB_CLIENT_ID=com.bystrobarista.web

# Google. CLIENT_IDS = web client id + iOS client id (comma-separated); the secret
# belongs to the web client and only serves the hosted-OAuth fallback.
GOOGLE_ENABLED=true
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=

############
# Edge function secrets (were `supabase secrets list` on the cloud project)
############

APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.quickbarista.app
INTERNAL_AUTH_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@bystrobarista.com
SEND_WEB_PUSH=true
YANDEX_CLIENT_ID=7d806d40921445e6beafbe8250e0772d
YANDEX_CLIENT_SECRET=

############
# Storage
############

GLOBAL_S3_BUCKET=bystrobarista
REGION=ru-1
STORAGE_TENANT_ID=bystrobarista
IMGPROXY_AUTO_WEBP=true

############
# Functions / API
############

FUNCTIONS_VERIFY_JWT=true
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
API_GW_HTTP_PORT=8000

############
# Backups (scripts/backup.sh) — S3-compatible bucket at the same provider
############

BACKUP_RCLONE_REMOTE=bb-s3
BACKUP_BUCKET=bystrobarista-backups
BACKUP_RETENTION_DAYS=14
