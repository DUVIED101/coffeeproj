# Supabase (same project as mobile: zifvfsamfzepxxuxhyhg)
NEXT_PUBLIC_SUPABASE_URL=https://zifvfsamfzepxxuxhyhg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Roskomnadzor bypass — browser clients in RU timezones route through this
NEXT_PUBLIC_SUPABASE_PROXY_URL=https://api.bystrobarista.com

# HMAC secret for signed cookies: the middleware profile cache (bb_profile)
# and the OAuth state cookie (bb_oauth_state).
# Any long random string; rotate to invalidate all cached role lookups.
BB_PROFILE_COOKIE_SECRET=

# Web Push (Phase 6): VAPID public key, base64url. Private key lives in Supabase Edge Function secrets.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Social auth on web (Phase 7). An empty value hides that provider's button.
# Apple: Services ID registered for the web domain (NOT the iOS bundle id);
# its Return URL must be https://<origin>/auth/callback/apple.
NEXT_PUBLIC_APPLE_SERVICES_ID=
# Google: "Web application" OAuth client id from Google Cloud with the site
# origin (and http://localhost:3000) in Authorized JavaScript origins. The
# id_token is minted in the browser (Google Identity Services) and posted to
# Supabase through the RU proxy — the same path mobile uses. Also add this id
# to the Supabase Google provider's authorized Client IDs. When empty, the
# Google button falls back to Supabase-hosted OAuth (not reachable from RU).
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Yandex: the mobile OAuth app with a "Web services" platform added; callback
# https://<origin>/auth/callback/yandex. The code exchange uses PKCE.
NEXT_PUBLIC_YANDEX_CLIENT_ID=
# Optional — only if Yandex rejects the secret-less PKCE exchange for web apps.
YANDEX_CLIENT_SECRET=
# "true" hides every social button (email-only fallback / kill switch).
NEXT_PUBLIC_DISABLE_SOCIAL_AUTH=
